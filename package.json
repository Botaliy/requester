{
  "name": "requester",
  "version": "1.0.0",
  "description": "Desktop WebSocket client for messages, scenarios and automation",
  "homepage": "https://github.com/Botaliy/requester#readme",
  "bugs": {
    "url": "https://github.com/Botaliy/requester/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Botaliy/requester.git"
  },
  "license": "ISC",
  "author": "Vitalii Pozdeev",
  "type": "commonjs",
  "main": "requester.js",
  "scripts": {
    "test": "node --test",
    "build:editor": "esbuild composer-editor.mjs --bundle --minify --format=iife --global-name=RequesterCodeEditor --outfile=composer-editor.bundle.js",
    "check": "npm run build:editor && node --check requester.js && node --check preload.js && node --check renderer.js && node --check engine.js && node --check composer-editor.bundle.js",
    "start": "npm run build:editor && electron .",
    "pack": "npm run build:editor && electron-builder --dir",
    "dist": "npm run dist:arm64",
    "dist:arm64": "npm run build:editor && electron-builder --mac dmg zip --arm64",
    "dist:x64": "npm run build:editor && electron-builder --mac dmg zip --x64"
  },
  "devDependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "codemirror": "^6.0.2",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1"
  },
  "dependencies": {
    "ws": "^8.21.2"
  },
  "build": {
    "appId": "com.botaliy.requester",
    "productName": "Requester",
    "asar": true,
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "styles.css",
      "renderer.js",
      "composer-editor.bundle.js",
      "preload.js",
      "requester.js",
      "engine.js",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": "-"
    }
  }
}
